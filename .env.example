# AutoApply Environment Configuration
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-me-to-a-random-secret
FLASK_DEBUG=true

# Database
DATABASE_URL=sqlite:///autoapply.db

# OpenRouter (cloud LLM — get a free key at https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Free model — change to any model on openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama (local LLM — only needed if running Ollama locally instead of OpenRouter)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Browser
HEADLESS=false
SLOW_MO=50

# Agent defaults (can also be set via UI Settings page)
MIN_FIT_SCORE=0.65
MAX_DAILY_APPLICATIONS=20
SEARCH_INTERVAL_MINUTES=60
DEFAULT_KEYWORDS=Python Developer,AI Engineer,Backend Engineer
DEFAULT_LOCATION=Remote

# Platform credentials (set via UI Settings page instead)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
